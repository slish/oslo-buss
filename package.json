{
  "name": "oslo-buss",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fanprosjekt: Oslo-busser som lyspunkt, basert på åpne data fra Entur",
  "scripts": {
    "timetable": "tsx scripts/build-timetable.ts",
    "relay": "tsx src/relay/dev-server.ts",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "check-timetable": "tsx scripts/check-timetable.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "map": "tsx scripts/build-map.ts",
    "deploy": "npm run build && wrangler deploy",
    "worker": "wrangler dev"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0",
    "yauzl": "^3.4.0"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "license": "MIT"
}

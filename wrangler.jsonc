// Oslo-buss on Cloudflare: a Worker that serves the built page (dist/) and, on the two live paths, a Durable Object that
// asks Entur once for everyone. Deploy with `npm run deploy` (builds first). See docs/HOSTING.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oslo-buss",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // Only these reach the Worker; every other path is a file, served free and without running any code.
    "run_worker_first": ["/feeds/*", "/data/timetable.json", "/health"]
  },
  "durable_objects": {
    "bindings": [{ "name": "FEEDS", "class_name": "Feeds" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Feeds"] }],
  "vars": {
    // The daily timetable, written by .github/workflows/timetable.yml to the `data` branch.
    "TIMETABLE_URL": "https://raw.githubusercontent.com/slish/oslo-buss/data/timetable.json"
  },
  "observability": { "enabled": true }
}
